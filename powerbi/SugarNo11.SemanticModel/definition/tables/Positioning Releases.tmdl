table 'Positioning Releases'

	measure 'Latest Net Contracts' = ```
		VAR LatestDate =
		    CALCULATE(MAX('Positioning Releases'[report_date]), REMOVEFILTERS('Positioning Releases'))
		RETURN
		    CALCULATE(
		        MAX('Positioning Releases'[managed_money_net_contracts]),
		        REMOVEFILTERS('Positioning Releases'),
		        'Positioning Releases'[report_date] = LatestDate
		    )
		```
		formatString: #,0;−#,0;–
		displayFolder: Report measures

	measure 'Previous Net Contracts' = ```
		VAR LatestDate =
		    CALCULATE(MAX('Positioning Releases'[report_date]), REMOVEFILTERS('Positioning Releases'))
		VAR PriorDate =
		    CALCULATE(
		        MAX('Positioning Releases'[report_date]),
		        REMOVEFILTERS('Positioning Releases'),
		        'Positioning Releases'[report_date] < LatestDate
		    )
		RETURN
		    CALCULATE(
		        MAX('Positioning Releases'[managed_money_net_contracts]),
		        REMOVEFILTERS('Positioning Releases'),
		        'Positioning Releases'[report_date] = PriorDate
		    )
		```
		formatString: #,0;−#,0;–
		displayFolder: Report measures

	measure 'Latest Net as % OI' = ```
		VAR LatestDate =
		    CALCULATE(MAX('Positioning Releases'[report_date]), REMOVEFILTERS('Positioning Releases'))
		RETURN
		    CALCULATE(
		        MAX('Positioning Releases'[normalized_net]),
		        REMOVEFILTERS('Positioning Releases'),
		        'Positioning Releases'[report_date] = LatestDate
		    )
		```
		formatString: 0.00%;−0.00%;–
		displayFolder: Report measures

	measure 'Latest Rule Status' = ```
		VAR LatestDate =
		    CALCULATE(MAX('Positioning Releases'[report_date]), REMOVEFILTERS('Positioning Releases'))
		VAR SignalRows =
		    CALCULATE(
		        COUNTROWS('Positioning Releases'),
		        REMOVEFILTERS('Positioning Releases'),
		        'Positioning Releases'[report_date] = LatestDate,
		        'Positioning Releases'[signal_emitted] = TRUE()
		    )
		RETURN IF(SignalRows > 0, "EMITTED", "NO SIGNAL")
		```
		displayFolder: Report measures

	measure 'Normalized Net (Recent)' = ```
		VAR CurrentDate = MAX('Positioning Releases'[report_date])
		RETURN
		    IF(CurrentDate >= DATE(2024, 1, 1), MAX('Positioning Releases'[normalized_net]))
		```
		formatString: 0.0%;−0.0%;–
		displayFolder: Report measures

	measure 'Prior-only Q10 (Recent)' = ```
		VAR CurrentDate = MAX('Positioning Releases'[report_date])
		RETURN
		    IF(CurrentDate >= DATE(2024, 1, 1), MAX('Positioning Releases'[prior_q10]))
		```
		formatString: 0.0%;−0.0%;–
		displayFolder: Report measures

	measure 'Rule Event (Recent)' = ```
		VAR CurrentDate = MAX('Positioning Releases'[report_date])
		VAR IsSignal =
		    COUNTROWS(FILTER('Positioning Releases', 'Positioning Releases'[signal_emitted] = TRUE())) > 0
		RETURN
		    IF(
		        CurrentDate >= DATE(2024, 1, 1) && IsSignal,
		        MAX('Positioning Releases'[normalized_net])
		    )
		```
		formatString: 0.0%;−0.0%;–
		displayFolder: Report measures

	column market_name
		dataType: string
		summarizeBy: none
		sourceColumn: market_name

	column cftc_contract_market_code
		dataType: string
		summarizeBy: none
		sourceColumn: cftc_contract_market_code

	column report_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: report_date

	column available_at_utc
		dataType: string
		summarizeBy: none
		sourceColumn: available_at_utc

	column availability_basis
		dataType: string
		summarizeBy: none
		sourceColumn: availability_basis

	column source_id
		dataType: string
		summarizeBy: none
		sourceColumn: source_id

	column source_url
		dataType: string
		dataCategory: WebUrl
		summarizeBy: none
		sourceColumn: source_url

	column source_sha256
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: source_sha256

	column source_sha256_short
		dataType: string
		summarizeBy: none
		sourceColumn: source_sha256_short

	column managed_money_long_contracts
		dataType: int64
		summarizeBy: none
		sourceColumn: managed_money_long_contracts

	column managed_money_short_contracts
		dataType: int64
		summarizeBy: none
		sourceColumn: managed_money_short_contracts

	column managed_money_net_contracts
		dataType: int64
		summarizeBy: none
		sourceColumn: managed_money_net_contracts

	column open_interest_contracts
		dataType: int64
		summarizeBy: none
		sourceColumn: open_interest_contracts

	column normalized_net
		dataType: double
		summarizeBy: none
		sourceColumn: normalized_net

	column prior_release_count
		dataType: int64
		summarizeBy: none
		sourceColumn: prior_release_count

	column prior_q10
		dataType: double
		summarizeBy: none
		sourceColumn: prior_q10

	column previous_normalized_net
		dataType: double
		summarizeBy: none
		sourceColumn: previous_normalized_net

	column previous_was_q10_extreme
		dataType: boolean
		summarizeBy: none
		sourceColumn: previous_was_q10_extreme

	column positive_reversal
		dataType: boolean
		summarizeBy: none
		sourceColumn: positive_reversal

	column cooldown_eligible
		dataType: boolean
		summarizeBy: none
		sourceColumn: cooldown_eligible

	column signal_emitted
		dataType: boolean
		summarizeBy: none
		sourceColumn: signal_emitted

	column rule_id
		dataType: string
		summarizeBy: none
		sourceColumn: rule_id

	partition 'Positioning Releases' = m
		mode: import
		source =
			let
				Encoded = "",
				Raw = Binary.FromText(Encoded, BinaryEncoding.Base64),
				Parsed = Csv.Document(
					Raw,
					[Delimiter = ",", Columns = 22, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				),
				Headers = Table.PromoteHeaders(Parsed, [PromoteAllScalars = true]),
				BlanksToNull = Table.ReplaceValue(
					Headers,
					"",
					null,
					Replacer.ReplaceValue,
					{"market_name", "cftc_contract_market_code", "report_date", "available_at_utc", "availability_basis", "source_id", "source_url", "source_sha256", "source_sha256_short", "managed_money_long_contracts", "managed_money_short_contracts", "managed_money_net_contracts", "open_interest_contracts", "normalized_net", "prior_release_count", "prior_q10", "previous_normalized_net", "previous_was_q10_extreme", "positive_reversal", "cooldown_eligible", "signal_emitted", "rule_id"}
				),
				Typed = Table.TransformColumnTypes(
					BlanksToNull,
					{
						{"market_name", type text},
						{"cftc_contract_market_code", type text},
						{"report_date", type date},
						{"available_at_utc", type text},
						{"availability_basis", type text},
						{"source_id", type text},
						{"source_url", type text},
						{"source_sha256", type text},
						{"source_sha256_short", type text},
						{"managed_money_long_contracts", Int64.Type},
						{"managed_money_short_contracts", Int64.Type},
						{"managed_money_net_contracts", Int64.Type},
						{"open_interest_contracts", Int64.Type},
						{"normalized_net", type number},
						{"prior_release_count", Int64.Type},
						{"prior_q10", type number},
						{"previous_normalized_net", type number},
						{"previous_was_q10_extreme", type logical},
						{"positive_reversal", type logical},
						{"cooldown_eligible", type logical},
						{"signal_emitted", type logical},
						{"rule_id", type text}
					},
					"en-US"
				)
			in
				Typed

	annotation PBI_ResultType = Table
