table 'WASDE Revisions'

	measure 'Aug 2026 Revision (k STRV)' = ```
		CALCULATE(
		    SUM('WASDE Revisions'[revision]),
		    KEEPFILTERS('WASDE Revisions'[region] = "United States"),
		    KEEPFILTERS('WASDE Revisions'[market_year] = "2026/27"),
		    KEEPFILTERS('WASDE Revisions'[report_date] = DATE(2026, 8, 12)),
		    KEEPFILTERS(
		        'WASDE Revisions'[attribute] IN {
		            "Beginning Stocks", "Production", "Total Supply", "Ending Stocks"
		        }
		    )
		)
		```
		formatString: +#,0;−#,0;–
		displayFolder: Report measures

	measure 'US 26/27 Stocks Use Jul' = ```
		DIVIDE(
		    CALCULATE(
		    MAX('WASDE Revisions'[prior_value]),
		    REMOVEFILTERS('WASDE Revisions'),
		    'WASDE Revisions'[region] = "United States",
		    'WASDE Revisions'[market_year] = "2026/27",
		    'WASDE Revisions'[report_date] = DATE(2026, 8, 12),
		    'WASDE Revisions'[attribute] = "Stocks to Use Ratio"
		    ),
		    100
		)
		```
		formatString: 0.0%
		displayFolder: Report measures

	measure 'US 26/27 Stocks Use Aug' = ```
		DIVIDE(
		    CALCULATE(
		    MAX('WASDE Revisions'[value]),
		    REMOVEFILTERS('WASDE Revisions'),
		    'WASDE Revisions'[region] = "United States",
		    'WASDE Revisions'[market_year] = "2026/27",
		    'WASDE Revisions'[report_date] = DATE(2026, 8, 12),
		    'WASDE Revisions'[attribute] = "Stocks to Use Ratio"
		    ),
		    100
		)
		```
		formatString: 0.0%
		displayFolder: Report measures

	measure 'US 26/27 Stocks Use Move' = ```
		CALCULATE(
		    MAX('WASDE Revisions'[revision]),
		    REMOVEFILTERS('WASDE Revisions'),
		    'WASDE Revisions'[region] = "United States",
		    'WASDE Revisions'[market_year] = "2026/27",
		    'WASDE Revisions'[report_date] = DATE(2026, 8, 12),
		    'WASDE Revisions'[attribute] = "Stocks to Use Ratio"
		)
		```
		formatString: +0.0 pp;−0.0 pp;–
		displayFolder: Report measures

	column vintage_id
		dataType: string
		summarizeBy: none
		sourceColumn: vintage_id

	column prior_vintage_id
		dataType: string
		summarizeBy: none
		sourceColumn: prior_vintage_id

	column wasde_number
		dataType: int64
		summarizeBy: none
		sourceColumn: wasde_number

	column report_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: report_date

	column report_label
		dataType: string
		summarizeBy: none
		sourceColumn: report_label

	column effective_at_utc
		dataType: string
		summarizeBy: none
		sourceColumn: effective_at_utc

	column available_at_utc
		dataType: string
		summarizeBy: none
		sourceColumn: available_at_utc

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column market_year
		dataType: string
		summarizeBy: none
		sourceColumn: market_year

	column attribute
		dataType: string
		summarizeBy: none
		sourceColumn: attribute
		sortByColumn: attribute_sort

	column attribute_sort
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: attribute_sort

	column normalized_unit
		dataType: string
		summarizeBy: none
		sourceColumn: normalized_unit

	column value
		dataType: double
		summarizeBy: none
		sourceColumn: value

	column prior_value
		dataType: double
		summarizeBy: none
		sourceColumn: prior_value

	column revision
		dataType: double
		summarizeBy: none
		sourceColumn: revision

	column source_version
		dataType: string
		summarizeBy: none
		sourceColumn: source_version

	column is_corrected_repost
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_corrected_repost

	column is_decision_story
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: is_decision_story

	partition 'WASDE Revisions' = m
		mode: import
		source =
			let
				Encoded = "",
				Raw = Binary.FromText(Encoded, BinaryEncoding.Base64),
				Parsed = Csv.Document(
					Raw,
					[Delimiter = ",", Columns = 18, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				),
				Headers = Table.PromoteHeaders(Parsed, [PromoteAllScalars = true]),
				BlanksToNull = Table.ReplaceValue(
					Headers,
					"",
					null,
					Replacer.ReplaceValue,
					{"vintage_id", "prior_vintage_id", "wasde_number", "report_date", "report_label", "effective_at_utc", "available_at_utc", "region", "market_year", "attribute", "attribute_sort", "normalized_unit", "value", "prior_value", "revision", "source_version", "is_corrected_repost", "is_decision_story"}
				),
				Typed = Table.TransformColumnTypes(
					BlanksToNull,
					{
						{"vintage_id", type text},
						{"prior_vintage_id", type text},
						{"wasde_number", Int64.Type},
						{"report_date", type date},
						{"report_label", type text},
						{"effective_at_utc", type text},
						{"available_at_utc", type text},
						{"region", type text},
						{"market_year", type text},
						{"attribute", type text},
						{"attribute_sort", Int64.Type},
						{"normalized_unit", type text},
						{"value", type number},
						{"prior_value", type number},
						{"revision", type number},
						{"source_version", type text},
						{"is_corrected_repost", type logical},
						{"is_decision_story", type logical}
					},
					"en-US"
				)
			in
				Typed

	annotation PBI_ResultType = Table
