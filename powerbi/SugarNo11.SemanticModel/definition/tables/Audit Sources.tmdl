table 'Audit Sources'

	measure 'Positioning Release Count' = ```
		COUNTROWS('Positioning Releases')
		```
		formatString: #,0
		displayFolder: Report measures

	measure 'WASDE Vintage Count' = ```
		DISTINCTCOUNT('WASDE Vintages'[vintage_id])
		```
		formatString: #,0
		displayFolder: Report measures

	measure 'Audit Corrected Reposts' = ```
		CALCULATE(
		    DISTINCTCOUNT('WASDE Vintages'[vintage_id]),
		    'WASDE Vintages'[is_corrected_repost] = TRUE()
		)
		```
		formatString: #,0
		displayFolder: Report measures

	measure 'Provenance Complete' = ```
		DIVIDE(
		    COUNTROWS(
		        FILTER(
		            'Audit Sources',
		            NOT ISBLANK('Audit Sources'[source_url])
		                && NOT ISBLANK('Audit Sources'[source_sha256])
		                && NOT ISBLANK('Audit Sources'[available_at_utc])
		        )
		    ),
		    COUNTROWS('Audit Sources')
		)
		```
		formatString: 0.0%
		displayFolder: Report measures

	measure 'Audit Unit Warnings' = ```
		SUM('Audit Sources'[unit_warning_count])
		```
		formatString: #,0
		displayFolder: Report measures

	column dataset
		dataType: string
		summarizeBy: none
		sourceColumn: dataset

	column record_key
		dataType: string
		summarizeBy: none
		sourceColumn: record_key

	column report_label
		dataType: string
		summarizeBy: none
		sourceColumn: report_label

	column report_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: report_date

	column available_at_utc
		dataType: string
		summarizeBy: none
		sourceColumn: available_at_utc

	column availability_basis
		dataType: string
		summarizeBy: none
		sourceColumn: availability_basis

	column source_version
		dataType: string
		summarizeBy: none
		sourceColumn: source_version

	column is_corrected_repost
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_corrected_repost

	column source_url
		dataType: string
		dataCategory: WebUrl
		summarizeBy: none
		sourceColumn: source_url

	column source_sha256
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: source_sha256

	column sha256_short
		dataType: string
		summarizeBy: none
		sourceColumn: sha256_short

	column unit_warning_count
		dataType: int64
		summarizeBy: none
		sourceColumn: unit_warning_count

	partition 'Audit Sources' = m
		mode: import
		source =
			let
				Encoded = "",
				Raw = Binary.FromText(Encoded, BinaryEncoding.Base64),
				Parsed = Csv.Document(
					Raw,
					[Delimiter = ",", Columns = 12, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				),
				Headers = Table.PromoteHeaders(Parsed, [PromoteAllScalars = true]),
				BlanksToNull = Table.ReplaceValue(
					Headers,
					"",
					null,
					Replacer.ReplaceValue,
					{"dataset", "record_key", "report_label", "report_date", "available_at_utc", "availability_basis", "source_version", "is_corrected_repost", "source_url", "source_sha256", "sha256_short", "unit_warning_count"}
				),
				Typed = Table.TransformColumnTypes(
					BlanksToNull,
					{
						{"dataset", type text},
						{"record_key", type text},
						{"report_label", type text},
						{"report_date", type date},
						{"available_at_utc", type text},
						{"availability_basis", type text},
						{"source_version", type text},
						{"is_corrected_repost", type logical},
						{"source_url", type text},
						{"source_sha256", type text},
						{"sha256_short", type text},
						{"unit_warning_count", Int64.Type}
					},
					"en-US"
				)
			in
				Typed

	annotation PBI_ResultType = Table
