		summarizeBy: none
		sourceColumn: available_at_utc

	column available_at_basis
		dataType: string
		summarizeBy: none
		sourceColumn: available_at_basis

	column retrieved_at_utc
		dataType: string
		summarizeBy: none
		sourceColumn: retrieved_at_utc

	column source_version
		dataType: string
		summarizeBy: none
		sourceColumn: source_version

	column is_corrected_repost
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_corrected_repost

	column source_url
		dataType: string
		dataCategory: WebUrl
		summarizeBy: none
		sourceColumn: source_url

	column source_sha256
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: source_sha256

	column source_sha256_short
		dataType: string
		summarizeBy: none
		sourceColumn: source_sha256_short

	column report_title
		dataType: string
		summarizeBy: none
		sourceColumn: report_title

	column commodity
		dataType: string
		summarizeBy: none
		sourceColumn: commodity

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column market_year
		dataType: string
		summarizeBy: none
		sourceColumn: market_year

	column projection_status
		dataType: string
		summarizeBy: none
		sourceColumn: projection_status

	column attribute
		dataType: string
		summarizeBy: none
		sourceColumn: attribute

	column raw_value
		dataType: string
		summarizeBy: none
		sourceColumn: raw_value

	column value
		dataType: double
		summarizeBy: none
		sourceColumn: value

	column raw_unit
		dataType: string
		summarizeBy: none
		sourceColumn: raw_unit

	column normalized_unit
		dataType: string
		summarizeBy: none
		sourceColumn: normalized_unit

	column unit_warning
