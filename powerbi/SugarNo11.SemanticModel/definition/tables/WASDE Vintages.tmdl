table 'WASDE Vintages'

	measure 'Vintage Count' = ```
		DISTINCTCOUNT('WASDE Vintages'[vintage_id])
		```
		formatString: #,0
		displayFolder: Report measures

	measure 'Corrected Reposts' = ```
		CALCULATE(
		    DISTINCTCOUNT('WASDE Vintages'[vintage_id]),
		    'WASDE Vintages'[is_corrected_repost] = TRUE()
		)
		```
		formatString: #,0
		displayFolder: Report measures

	measure 'Unit Warning Rows' = ```
		CALCULATE(
		    COUNTROWS('WASDE Vintages'),
		    'WASDE Vintages'[has_unit_warning] = TRUE()
		)
		```
		formatString: #,0
		displayFolder: Report measures

	column vintage_id
		dataType: string
		summarizeBy: none
		sourceColumn: vintage_id

	column wasde_number
		dataType: int64
		summarizeBy: none
		sourceColumn: wasde_number

	column report_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: report_date

	column report_label
		dataType: string
		summarizeBy: none
		sourceColumn: report_label

	column effective_at_utc
		dataType: string
		summarizeBy: none
		sourceColumn: effective_at_utc

	column available_at_utc
