	column has_unit_warning
		dataType: boolean
		summarizeBy: none
		sourceColumn: has_unit_warning

	partition 'WASDE Vintages' = m
		mode: import
		source =
			let
				Encoded = "",
				Raw = Binary.FromText(Encoded, BinaryEncoding.Base64),
				Parsed = Csv.Document(
					Raw,
					[Delimiter = ",", Columns = 25, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				),
				Headers = Table.PromoteHeaders(Parsed, [PromoteAllScalars = true]),
				BlanksToNull = Table.ReplaceValue(
					Headers,
					"",
					null,
					Replacer.ReplaceValue,
					{"vintage_id", "wasde_number", "report_date", "report_label", "effective_at_utc", "available_at_utc", "available_at_basis", "retrieved_at_utc", "source_version", "is_corrected_repost", "source_url", "source_sha256", "source_sha256_short", "report_title", "commodity", "region", "market_year", "projection_status", "attribute", "raw_value", "value", "raw_unit", "normalized_unit", "unit_warning", "has_unit_warning"}
				),
				Typed = Table.TransformColumnTypes(
					BlanksToNull,
					{
						{"vintage_id", type text},
						{"wasde_number", Int64.Type},
						{"report_date", type date},
						{"report_label", type text},
						{"effective_at_utc", type text},
						{"available_at_utc", type text},
						{"available_at_basis", type text},
						{"retrieved_at_utc", type text},
						{"source_version", type text},
						{"is_corrected_repost", type logical},
						{"source_url", type text},
						{"source_sha256", type text},
						{"source_sha256_short", type text},
						{"report_title", type text},
						{"commodity", type text},
						{"region", type text},
						{"market_year", type text},
						{"projection_status", type text},
						{"attribute", type text},
						{"raw_value", type text},
						{"value", type number},
						{"raw_unit", type text},
						{"normalized_unit", type text},
						{"unit_warning", type text},
						{"has_unit_warning", type logical}
					},
					"en-US"
				)
			in
				Typed

	annotation PBI_ResultType = Table
